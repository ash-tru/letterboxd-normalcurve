{
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route=/api/$1"
    },
    {
      "source": "/styles.css",
      "destination": "/api/index.py?__route=/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/api/index.py?__route=/app.js"
    },
    {
      "source": "/favicon.svg",
      "destination": "/api/index.py?__route=/favicon.svg"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index.py?__route=/favicon.svg"
    },
    {
      "source": "/",
      "destination": "/api/index.py?__route=/"
    }
  ]
}
